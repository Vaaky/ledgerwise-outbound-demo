# Ledgerwise demo — copy to .env.local

# Postgres (Neon free tier). Leave empty to use the built-in PGlite file DB locally.
DATABASE_URL=

# Optional: any OpenAI-compatible LLM endpoint (Groq, llama.cpp, Ollama, vLLM, LM Studio).
# Leave LLM_BASE_URL empty to use Groq. Without any LLM config the demo uses a deterministic mock writer and reply templates.
# Local example: LLM_BASE_URL=http://localhost:8000/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Qwen3: set 1 to append /no_think and skip reasoning tokens.
LLM_NO_THINK=
# Local models can be slow; Groq answers in ~1s.
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.3

# Groq convenience aliases (still supported).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: live web search for research (Tavily free tier, 1000 credits/mo).
TAVILY_API_KEY=

# Optional: real outbound email (Resend free tier). Without it sends are simulated.
RESEND_API_KEY=
RESEND_FROM=Ledgerwise Demo <onboarding@resend.dev>
DEMO_INBOX=

# Set to 1 to force the deterministic mock model even when a key exists. Leave empty to use the live model.
FORCE_MOCK=
